@using LogiCore.Server.Models.Shipments
@using LogiCore.Client.Services.Shipments



<RadzenTemplateForm TItem="AddShipmentEventDto" Data="@EventDto" Submit="@OnSubmit">
    <RadzenRow Gap="0.75rem">
        <RadzenColumn Size="12">
            <RadzenLabel Text="Event Type *" />
            <RadzenDropDown @bind-Value="EventDto.EventType" Data="@eventTypes"
                            TextProperty="Label" ValueProperty="Value" Name="EventType" Style="width:100%" />
            <RadzenRequiredValidator Component="EventType" Text="Event type is required" />
        </RadzenColumn>
        <RadzenColumn Size="12">
            <RadzenLabel Text="Location" />
            <RadzenTextBox @bind-Value="EventDto.Location" Placeholder="e.g. Chicago Hub, IL" Style="width:100%" />
        </RadzenColumn>
        <RadzenColumn Size="12">
            <RadzenLabel Text="Notes" />
            <RadzenTextArea @bind-Value="EventDto.Notes" Rows="3" Style="width:100%"
                            Placeholder="Additional details…" />
        </RadzenColumn>
        <RadzenColumn Size="12">
            <RadzenLabel Text="Operator / Agent" />
            <RadzenTextBox @bind-Value="EventDto.OperatorName" Placeholder="Name or system ID" Style="width:100%" />
        </RadzenColumn>
    </RadzenRow>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-4">
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
        <RadzenButton Text="Add Event" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit"
                      IsBusy="@isSaving" BusyText="Saving…" />
    </RadzenStack>
</RadzenTemplateForm>
